[Unit]
Description=secgw IPS AI — Suricata 흐름 기록을 GBDT로 판정해 nftables ai_block 에 추가
After=secgw-ips.service secgw-nft.service
Requires=secgw-nft.service

[Service]
Slice=secgw.slice
User=secgw
Group=secgw
EnvironmentFile=${SECGW_ETC}/ai.env
ExecStart=${SECGW_HOME}/venv/bin/python ${SECGW_HOME}/ai/ips_ai.py --bundle ${SECGW_HOME}/models/ips --eve ${SECGW_LOG}/eve.json
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
CPUQuota=${IPS_AI_CPU}
MemoryHigh=${IPS_AI_MEM_HIGH}
MemoryMax=${IPS_AI_MEM}
TasksMax=32
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=${SECGW_HOME} ${SECGW_LOG}

[Install]
WantedBy=multi-user.target
