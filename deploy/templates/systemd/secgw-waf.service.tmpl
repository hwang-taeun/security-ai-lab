[Unit]
Description=secgw WAF — Caddy + OWASP Coraza(CRS PL${CRS_PARANOIA})
After=network-online.target secgw-waf-ai.service
Wants=secgw-waf-ai.service

[Service]
Slice=secgw.slice
User=caddy
Group=caddy
ExecStart=${SECGW_HOME}/bin/caddy run --config ${SECGW_ETC}/Caddyfile --adapter caddyfile
AmbientCapabilities=CAP_NET_BIND_SERVICE
CPUQuota=${WAF_CPU}
MemoryHigh=${WAF_MEM_HIGH}
MemoryMax=${WAF_MEM}
TasksMax=512
LimitNOFILE=65536
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=${SECGW_LOG} /var/lib/caddy
Environment=XDG_DATA_HOME=/var/lib/caddy

[Install]
WantedBy=multi-user.target
